{
  "name": "Peer Club - Daily Streak Reset & Check Automation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 * * *"
            }
          ]
        }
      },
      "name": "Midnight Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:4000/api/internal/check-streaks",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-secret",
              "value": "peer_club_n8n_secret_token_123"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "name": "Trigger Streak Check & Reset",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nreturn [{\n  json: {\n    executedAt: new Date().toISOString(),\n    status: response.status || 'ok',\n    checkedUsers: response.checkedUsers || 0,\n    resetCount: response.resetCount || 0,\n    message: response.message || 'Streak check completed successfully'\n  }\n}];"
      },
      "name": "Log Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 300]
    }
  ],
  "connections": {
    "Midnight Schedule Trigger": {
      "main": [
        [
          {
            "node": "Trigger Streak Check & Reset",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Streak Check & Reset": {
      "main": [
        [
          {
            "node": "Log Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
