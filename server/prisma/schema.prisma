generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum FlashcardStatus {
  known
  revisit
}

enum NotificationType {
  reminder
  report
  achievement
}

model User {
  id        String   @id @default(uuid()) @map("_id")
  name      String
  email     String   @unique
  password  String   // Hashed password
  avatar    String?
  createdAt DateTime @default(now())

  // Relations
  administeredRooms StudyRoom[]    @relation("RoomAdmin")
  memberRooms       StudyRoom[]    @relation("RoomMembers")
  documents         Document[]
  studySessions     StudySession[]
  leaderboards      Leaderboard[]
  notifications     Notification[]

  @@map("users")
}

model StudyRoom {
  id         String   @id @default(uuid()) @map("_id")
  name       String
  subjectTag String
  roomCode   String   @unique
  adminId    String
  isPrivate  Boolean  @default(false)
  createdAt  DateTime @default(now())

  // Relations
  admin         User           @relation("RoomAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  members       User[]         @relation("RoomMembers")
  documents     Document[]
  studySessions StudySession[]
  leaderboard   Leaderboard[]

  @@index([adminId])
  @@map("studyrooms")
}

model Document {
  id         String   @id @default(uuid()) @map("_id")
  roomId     String
  uploadedBy String
  fileName   String
  fileUrl    String
  createdAt  DateTime @default(now())

  // Relations
  room       StudyRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  uploader   User        @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  quizzes    Quiz[]
  flashcards Flashcard[]

  @@index([roomId])
  @@index([uploadedBy])
  @@map("documents")
}

model Quiz {
  id         String   @id @default(uuid()) @map("_id")
  documentId String
  questions  Json     // Array of questions [{ question, options, answer, explanation }]
  difficulty String
  createdAt  DateTime @default(now())

  // Relations
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("quizzes")
}

model Flashcard {
  id         String          @id @default(uuid()) @map("_id")
  documentId String
  question   String          @db.Text
  answer     String          @db.Text
  status     FlashcardStatus @default(revisit)

  // Relations
  document   Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("flashcards")
}

model StudySession {
  id        String   @id @default(uuid()) @map("_id")
  userId    String
  roomId    String
  duration  Int      // Duration in minutes
  startTime DateTime
  endTime   DateTime

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roomId])
  @@map("studysessions")
}

model Leaderboard {
  id               String   @id @default(uuid()) @map("_id")
  roomId           String
  userId           String
  studyHours       Float    @default(0)
  quizzesCompleted Int      @default(0)
  streak           Int      @default(0)

  // Relations
  room             StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@map("leaderboard")
}

model Notification {
  id        String           @id @default(uuid()) @map("_id")
  userId    String
  message   String           @db.Text
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}
